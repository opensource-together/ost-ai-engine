# ================================================
#  OST Linker — Environment Configuration
#  Copy this file to .env and fill in the values.
#  By @spideystreet
# ================================================
#
# --- Optional: dev host ports (local machine only) ---
# Compose defaults match production/staging (Dagster :3000, Linker API :8000) when these are unset.
# Set the values below when running the full OST stack so Next.js can use :3000 and nothing fights :8000.
# Staging/prod typically uses `docker compose -f docker-compose.yml up` without this file and leaves these unset.
#
# DAGSTER_HOST_PORT=3030
# If 3030 is taken (e.g. Metabase), use 3033 or another free port.
# LINKER_API_HOST_PORT=8010
#
# If you change LINKER_API_HOST_PORT, set MCP `OST_API_URL` to http://localhost:<that port>
#
# ================================================

# --- Database ---
# Used by the Docker postgres container and all services.
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
POSTGRES_PORT=""
# Host reachable from your shell (compose publishes DB on POSTGRES_PORT — often localhost).
POSTGRES_HOST="localhost"

# Full connection string — must match POSTGRES_* values above.
DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/<POSTGRES_DB>"

# --- Dagster ---
# Must be an absolute path. Dagster looks for dagster.yaml inside this directory.
# Local:  DAGSTER_HOME="/absolute/path/to/ost-linker/dagster_home"
# Docker: DAGSTER_HOME="/app/dagster_home"
DAGSTER_HOME="/app/dagster_home"
# Optional: Postgres URL for Dagster run/event storage (compose defaults to DATABASE_URL).
# DAGSTER_PG_URL="${DATABASE_URL}"
# Subdirectories used by dagster.yaml — override only if you change DAGSTER_HOME
# DAGSTER_STORAGE_DIR="${DAGSTER_HOME}/storage"
# DAGSTER_LOGS_DIR="${DAGSTER_HOME}/logs"
# Optional dev override for host port (see top of file). Default 3000 when unset.
# DAGSTER_HOST_PORT=3000

# --- GitHub ---
# Fine-grained personal access token with read access on public repos.
GITHUB_ACCESS_TOKEN="<your_fine_grained_token>"

# Optional: override the GitHub Search API endpoint (default shown).
# GITHUB_API_URL="https://api.github.com/search/repositories"

# Optional: override scraping queries. Two modes (leave both empty to use built-in star ranges):
#   Single query  — set GITHUB_SCRAPING_QUERY to a raw GitHub search string.
#   Multi-query   — set GITHUB_SCRAPING_QUERIES to a JSON array of query strings (takes precedence).
# GITHUB_SCRAPING_QUERY=
# GITHUB_SCRAPING_QUERIES='["stars:300..1000 ...", "stars:1000..3000 ..."]'

# --- Go Binaries ---
# Paths to the compiled binaries.
# Compile with: scripts/go_binary_gen.sh
GO_SCRAPER_PATH="/path/to/ost-linker/src/services/go/scraper/github-scraper"
GO_FETCHER_PATH="/path/to/ost-linker/src/services/go/fetcher/ost-fetcher"
GO_TRENDING_PATH="/path/to/ost-linker/src/services/go/trending/ost-trending"

# --- ML Models ---
# Path to FastText language-detection model (lid.176.ftz).
# Download: https://fasttext.cc/docs/en/language-identification.html
FASTTEXT_MODEL_PATH="models/lid.176.ftz"

# --- LLM Classifier ---
# Mistral API key — used by LLMClassifierResource (default model: mistral-small-latest).
MISTRAL_API_KEY="<your_mistral_api_key>"

# --- Linker API (FastAPI in Docker; container listens on 8000) ---
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=60
# Optional shared header auth for internal callers; leave empty to keep API open.
OST_LINKER_SERVICE_TOKEN=
# Production: set to true with a non-empty OST_LINKER_SERVICE_TOKEN so the API refuses
# to start without a configured token. Leave unset/false for local dev.
# OST_LINKER_REQUIRE_SERVICE_TOKEN=false

# --- dbt ---
# Target profile: "local" (port 5433, default) or "docker" (port 5432, host "db").
# Set to "docker" when running inside a container.
# DBT_TARGET=local
# DBT_PROJECT_DIR=/app/dbt
